# Functional test for the barotropic tidal boundary forcing port
# (ROMS SSH_TIDES + UV_TIDES + ADD_FSOBC + ADD_M2OBC).
#
# NetCDF inputs are generated by Tests/MoanaParity/make_tide_test_files.py.
# The boundary file is identically zero, so anything that appears at the open
# boundaries comes from the tidal addition. Flat 100 m bathymetry, no rotation,
# and a linear equation of state with zero expansion coefficients make the
# response purely barotropic.
#
# With the default generated tide file (one constituent, period 12 h,
# tide_Eamp = 1 m, tide_Ephase = 90 deg) the boundary free surface is
#     zeta_bry(t) = 1.0 * sin(2*pi*t/43200)
# and the basin (100 km x 160 km, gravity-wave crossing time ~1 h << 12 h)
# follows it almost in equilibrium.

remora.prob_name = IdealMiniGrid

remora.max_step = 288

# PROBLEM SIZE & GEOMETRY (must match make_tide_test_files.py)
remora.prob_lo     =   0.       0.  -100.
remora.prob_hi     =   100000.  160000.  0.
remora.n_cell      =  10 16 4

remora.is_periodic = 0 0 0

remora.boundary_per_variable = 1
##                       WEST     SOUTH    EAST     NORTH
remora.bc.temp.type   =  clamped  clamped  clamped  clamped
remora.bc.salt.type   =  clamped  clamped  clamped  clamped
remora.bc.scalar.type =  clamped  clamped  clamped  clamped
remora.bc.u.type      =  clamped  clamped  clamped  clamped
remora.bc.v.type      =  clamped  clamped  clamped  clamped
remora.bc.ubar.type   =  clamped  clamped  clamped  clamped
remora.bc.vbar.type   =  clamped  clamped  clamped  clamped
remora.bc.zeta.type   =  clamped  clamped  clamped  clamped
remora.bc.tke.type    =  outflow  outflow  outflow  outflow

# TIME STEP CONTROL: 288 steps x 150 s = 12 h = one tidal period
remora.fixed_dt            = 150.0
remora.fixed_ndtfast_ratio = 20

remora.flat_bathymetry = 0

remora.v            = 0
remora.sum_interval = -1

remora.check_int = -1

remora.plot_file     = plt
remora.plot_int      = 6
remora.plot_vars_2d  = zeta ubar vbar
remora.plot_vars_3d  = salt temp x_velocity y_velocity
remora.plotfile_type = amrex

remora.tracer_horizontal_advection_scheme = "upstream3"

remora.use_coriolis = false

remora.theta_s = 3.0
remora.theta_b = 0.0
remora.tcline  = 50.

# Constant density: no baroclinic response, pure barotropic tide
remora.R0    = 1027.0
remora.S0    = 32.0
remora.T0    = 10.0
remora.Tcoef = 0.0
remora.Scoef = 0.0
remora.rho0  = 1025.0

remora.ic_bc_type     = "netcdf"
remora.nc_init_file_0 = "tidebox_ini.nc"
remora.nc_grid_file_0 = "tidebox_grd.nc"
remora.nc_bdry_file   = "tidebox_bry.nc"

# ---- tidal forcing (ROMS SSH_TIDES/UV_TIDES, TIDE_START, TIDENAME) ----
remora.tides         = true
remora.tide_start    = 0.0
remora.nc_tide_file  = "tidebox_tide.nc"
